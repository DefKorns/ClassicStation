<theme>
	<formatVersion>3</formatVersion>
	<defaultView>grid</defaultView>

	<include>./../theme.xml</include>

	<view name="basic, detailed, grid">
		<image name="bar_logo" extra="true">
			<visible>${barLogo}</visible>
			<path>${barLogoPath}</path>
			<color>${barLogoTint}</color>
			<pos>${barLogoPos}</pos>
			<maxSize>${barLogoMax}</maxSize>
			<origin>0.5 0.5</origin>
		</image>
	</view>

	<view name="system">
		<image name="bar_logo" extra="true">
			<visible>${barLogo}</visible>
			<path>${barLogoPath}</path>
			<color>${barLogoTint}</color>
			<pos>${barLogoPos}</pos>
			<maxSize>${barLogoMax}</maxSize>
			<origin>0.5 0.5</origin>
		</image>
	</view>
</theme>
