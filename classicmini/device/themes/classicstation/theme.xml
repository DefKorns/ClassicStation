			<color>FFFFFF</color>
			<alignment>left</alignment>
			<fields>releasedate publisher genre</fields>
			<separator>  ·  </separator>
			<zIndex>40</zIndex>
		</text>

		<image name="divider_2" extra="true">
			<path>./divider.png</path>
			<pos>0.2641 0.3639</pos>
			<size>0.2383 0.0028</size>
			<zIndex>40</zIndex>
		</image>

		<text name="md_description">
			<pos>0.2641 0.3778</pos>
			<size>0.2383 0.4028</size>
			<fontSize>0.0236</fontSize>
			<lineSpacing>1.25</lineSpacing>
			<color>FFFFFF</color>
			<alignment>left</alignment>
			<zIndex>40</zIndex>
		</text>

		<text name="md_lbl_rating, md_lbl_releasedate, md_lbl_developer, md_lbl_publisher, md_lbl_genre, md_lbl_players, md_lbl_lastplayed, md_lbl_playcount">
			<pos>1 1</pos>
			<size>0.1 0.05</size>
		</text>

		<text name="md_developer, md_publisher, md_genre, md_players, md_playcount">
			<pos>1 1</pos>
			<size>0.1 0.05</size>
		</text>

		<datetime name="md_releasedate, md_lastplayed">
			<pos>1 1</pos>
