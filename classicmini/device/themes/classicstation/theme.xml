			<manyPath>./players_many.png</manyPath>
			<zIndex>40</zIndex>
		</playersicon>

		<text name="md_name">
			<pos>0.2641 0.1597</pos>
			<size>0.2383 0.0903</size>
			<fontSize>0.07</fontSize>
			<color>FFFFFF</color>
			<alignment>left</alignment>
			<fitMinScale>0.5</fitMinScale>
			<zIndex>40</zIndex>
		</text>

		<image name="md_marquee">
			<pos>0.2641 0.2048</pos>
			<maxSize>0.2383 0.0903</maxSize>
			<origin>0 0.5</origin>
			<visible>true</visible>
			<zIndex>40</zIndex>
		</image>

