<theme>
	<formatVersion>3</formatVersion>
	<defaultView>grid</defaultView>

	<include>./../theme.xml</include>

	<view name="basic, detailed, grid">
		<image name="bar_logo" extra="true">
			<visible>${barLogo}</visible>
			<path>./../assets/systems/logos/snes.svg</path>
			<pos>0.0602 0.8875</pos>
			<maxSize>0.3211 0.0694</maxSize>
			<origin>0 0</origin>
		</image>
	</view>

	<view name="grid">
		<image name="tile_save">
			<path>./../save_icon.png</path>
			<pos>0.0977 0.377778</pos>
			<size>0.0422 0.0583</size>
			<origin>0 0</origin>
		</image>
	</view>

	<view name="system">
		<image name="bar_logo" extra="true">
			<visible>${barLogo}</visible>
			<path>./../assets/systems/logos/snes.svg</path>
			<pos>0.0602 0.8875</pos>
			<maxSize>0.3211 0.0694</maxSize>
			<origin>0 0</origin>
		</image>
	</view>
</theme>
